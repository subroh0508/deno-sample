{
  "tasks": {
    "dev": "deno run --allow-net --allow-env --allow-read --watch server.ts",
    "prisma:generate": "deno run -A npm:prisma generate",
    "prisma:migrate": "deno run -A npm:prisma migrate dev"
  },
  "imports": {
    "@hono/hono": "jsr:@hono/hono@^4.11.1",
    "@prisma/adapter-pg": "npm:@prisma/adapter-pg",
    "@prisma/client": "npm:@prisma/client",
    "@prisma/config": "npm:@prisma/config",
    "@std/assert": "jsr:@std/assert@1",
    "pg": "npm:pg",
    "prisma": "npm:prisma"
  },
  "nodeModulesDir": "auto",
  "allowScripts": [
    "npm:@prisma/client",
    "npm:@prisma/engines",
    "npm:prisma"
  ]
}
